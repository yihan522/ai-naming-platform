# ===== Supabase =====
# 项目设置 → Settings → API 中获取
SUPABASE_URL=https://你的项目编号.supabase.co
SUPABASE_ANON_KEY=你的anon_public密钥

# ===== 豆包（火山方舟）—— 本次实验默认模型 =====
# 火山方舟控制台 → API Key 管理
DOUBAO_API_KEY=你的火山方舟APIKey
# 模型名填「接入点 ID（ep-xxx）」或模型 ID，以方舟控制台实际显示为准
DOUBAO_MODEL=doubao-seed-2-1-pro-260628
# 如需更快出字，可关闭深度思考
# DOUBAO_THINKING=disabled
# 接口地址，官方为 OpenAI 兼容网关，一般不用改
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# ===== 其他模型（多模型切换用，没有就留空，页面会提示未配置） =====
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

QWEN_API_KEY=
QWEN_MODEL=qwen-plus
# 通义千问必须用 compatible-mode 地址
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

KIMI_API_KEY=
KIMI_MODEL=moonshot-v1-8k
KIMI_BASE_URL=https://api.moonshot.cn/v1
